rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Perfil: o próprio usuário pode ler. Criação/alteração fica no backend Admin SDK.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;

      // Cada login lê e grava SOMENTE o próprio caderno.
      match /caderno/{noteId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // Estrutura compartilhada antiga fica fechada. Os dados não são apagados.
    match /workspaces/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
